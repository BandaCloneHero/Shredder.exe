# Exemplo público. Não é carregado automaticamente pelo Node.
SHREDDER_GOOGLE_ONLY=true
# Habilitar após confirmar as origens autorizadas do cliente OAuth Web no Google.
SHREDDER_GOOGLE_AUTH_ENABLED=false
# Opcional: sobrescreve o ID público já registrado em google-config.json.
GOOGLE_CLIENT_ID=507538636611-be7h33ohjd8jnmh3cua8jjjhlarn4f0j.apps.googleusercontent.com
SHREDDER_PUBLIC_ORIGIN=https://shredder.feira-de-jogos.dev.br
# Nenhuma chave privada, ADC ou credencial Firebase é necessária para o login.

# Integração de créditos — manter desativada até definir o valor oficial.
SHREDDER_FEIRA_CREDITS_ENABLED=false
SHREDDER_FEIRA_CREDIT_VALUE=
# Produto fixo do Shredder: 87. Usa o token Google; não requer token administrativo.
