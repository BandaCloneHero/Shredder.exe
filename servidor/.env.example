# Exemplo público. Não é carregado automaticamente pelo Node.
SHREDDER_GOOGLE_ONLY=true
# Habilitar após confirmar as origens autorizadas do cliente OAuth Web no Google.
SHREDDER_GOOGLE_AUTH_ENABLED=false
# Opcional: sobrescreve o ID público já registrado em google-config.json.
GOOGLE_CLIENT_ID=507538636611-be7h33ohjd8jnmh3cua8jjjhlarn4f0j.apps.googleusercontent.com
SHREDDER_PUBLIC_ORIGIN=https://shredder.feira-de-jogos.dev.br
# Nenhuma chave privada, ADC ou credencial Firebase é necessária para o login.

# Créditos reais: ativar manualmente somente no servidor do teste autorizado.
SHREDDER_FEIRA_CREDITS_ENABLED=false
# secret: usa userId/price e o segredo do jogo, guardado exclusivamente no ambiente.
SHREDDER_FEIRA_CREDIT_AUTH=secret
SHREDDER_FEIRA_GAME_SECRET=
# Contrato do código postGameCredit.js fornecido. Se o responsável indicar adminCredit,
# trocar explicitamente a URL abaixo; não há fallback/reenvio entre rotas.
SHREDDER_FEIRA_GAME_CREDIT_URL=https://feira-de-jogos.dev.br/api/v2/gameCredit
# Alternativa google: /credit com product/value. Só usar se a Feira confirmar que
# o cadastro de 87 NÃO substituirá value por um preço fixo.
SHREDDER_FEIRA_CUSTOM_VALUES_CONFIRMED=false
# Os tetos e as músicas vêm de recompensas-campanha.json, não de valor fixo no .env.
